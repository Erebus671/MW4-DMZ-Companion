<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmzCompanion.App.Pages.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="24" Spacing="12" MaximumWidthRequest="480" HorizontalOptions="Start">
        <Label Text="Log level" FontAttributes="Bold" />
        <Picker x:Name="LogLevelPicker" SelectedIndexChanged="OnLogLevelChanged" />
    </VerticalStackLayout>
</ContentPage>
