<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DmzCompanion.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DmzCompanion.App.Pages"
    Title="DMZ Companion">

    <TabBar>
        <ShellContent Title="Map" ContentTemplate="{DataTemplate pages:MapPage}" Route="map" />
        <ShellContent Title="Loot" ContentTemplate="{DataTemplate pages:LootPage}" Route="loot" />
        <ShellContent Title="Resources" ContentTemplate="{DataTemplate pages:ResourcesPage}" Route="resources" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
    </TabBar>

</Shell>
